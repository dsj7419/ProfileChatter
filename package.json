{
  "name": "profilechatter",
  "version": "1.0.2",
  "description": "ProfileChatter – animated SVG chat bubbles for your GitHub README",
  "type": "module",
  "main": "src/main.js",
  "workspaces": [
    "configurator-ui"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate": "node -e \"import('node:fs').then(fs=>{import('./src/main.js').then(m=>{fs.mkdirSync('dist',{recursive:true});fs.writeFileSync('dist/profile-chat.svg',m.generateChatSVG());console.log('✔ SVG written to dist/profile-chat.svg');});});\"",
    "build": "node src/build-profile.js",
    "preview": "npm run build && cmd /c start test.html",
    "config:dev": "npm-run-all --parallel config:ui:dev config:server:preview",
    "config:ui:dev": "npm run dev --workspace configurator-ui -- --clearScreen=false",
    "config:server:preview": "node configurator-ui/server/previewServer.js",
    "config:build": "npm run build --workspace configurator-ui",
    "test": "vitest",
    "test:unit": "vitest run --dir tests/unit", 
    "test:integration": "vitest run --dir tests/integration",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "verify": "npm run lint && vitest run --coverage && npm run config:build",
    "repomix": "npx --yes repomix"
  },
  "keywords": [
    "svg",
    "chat",
    "github",
    "profile",
    "animation"
  ],
  "author": "Dan Johnson",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.4",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.0",
    "vitest": "^3.1.4"
  }
}
