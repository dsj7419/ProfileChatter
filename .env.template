# ProfileChatter Environment Variables
# --------------------------------------
# For LOCAL DEVELOPMENT:
# 1. Copy this file to a new file named '.env' in the project root.
# 2. Fill in your API keys below in the '.env' file.
# 3. The '.env' file is ignored by Git and MUST NOT be committed.
#
# For DEPLOYMENT (e.g., GitHub Actions):
# These variables MUST be configured as SECRETS in your repository settings.
# Do NOT commit your actual .env file or hardcode keys.
# --------------------------------------

# AccuWeather API Key for weather data
# Obtain from: https://developer.accuweather.com/
WEATHER_API_KEY=YOUR_ACCUWEATHER_API_KEY_HERE

# AccuWeather Location Key for your city
# Find your location key: https://developer.accuweather.com/accuweather-locations-api/apis
LOCATION_KEY=YOUR_ACCUWEATHER_LOCATION_KEY_HERE

# GitHub Personal Access Tokens
# PAT_GITHUB_BASIC - Avoid rate limiting with the GitHub API for public data
# Create at: https://github.com/settings/tokens with 'public_repo' scope
PAT_GITHUB_BASIC=YOUR_GITHUB_PAT_HERE

# PAT_GITHUB_OAUTH - Enable enhanced GitHub statistics and Direct Commit feature
# Create at: https://github.com/settings/tokens with 'repo' scope
PAT_GITHUB_OAUTH=YOUR_GITHUB_OAUTH_PAT_HERE

# WakaTime API Key (for coding stats)
# Obtain from: https://wakatime.com/settings/api-key
WAKATIME_API_KEY=YOUR_WAKATIME_API_KEY_HERE

# Twitter API v2 Bearer Token
# Obtain from your Twitter Developer Portal app settings
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN_HERE

# OAuth Configurations

# Spotify OAuth
# Register at: https://developer.spotify.com/dashboard/
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/callback

# GitHub OAuth
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET_HERE
GITHUB_REDIRECT_URI=http://127.0.0.1:3001/callback

# For local testing of CI mode (optional)
# GITHUB_DATA_MODE=ci
# Use PAT_GITHUB_OAUTH as your authentication token for CI mode